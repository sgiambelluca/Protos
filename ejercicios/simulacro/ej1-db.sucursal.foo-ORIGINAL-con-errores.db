$TTL 604800
@ IN SOA ns2.sucursal.foo. admin@sucursal.foo. (
        2026010501      ; Serial
        604800          ; Refresh
        86400           ; Retry
        2419200         ; Expire
        604800 )        ; Negative Cache TTL
; Name Servers
@       IN NS   ns1.sucursal.foo.
; Mail
@       IN MX   10 mail
; Hosts
ns1     IN A    192.168.50.1
www     IN A    web
mail    IN A    192.168.50.20
